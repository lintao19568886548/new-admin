# ！！！此文件用于保持跟踪，请勿随意修改。开发时请将此文件除此行注释外的所有内容，包括下面那行注释，复制到.env文件中！！！



# 此文件不跟踪，但项目在开发环境使用。生产环境已写入服务器，此文件不生效

HOST=0.0.0.0
PORT=5320
ACCESS_TOKEN_SECRET=access_syxd_magic_secret
REFRESH_TOKEN_SECRET=refresh_syxd_magic_secret

# 数据库路径
# DATABASE_URL="mysql://root:{password}@127.0.0.1:3307/magic?timezone=Asia/Shanghai"  # 服务器
DATABASE_URL="mysql://root:{password}@localhost:3306/magic?timezone=Asia/Shanghai"

NOTICES_DATABASE_URL="mysql://root:{password}@localhost:3306/spider?timezone=Asia/Shanghai"

CENTER_DATABASE_URL="mysql://root:{password}@localhost:3306/magic_center?timezone=Asia/Shanghai"
PUBLIC_DATABASE_URL=""

# Attendance automation test worker. Test/mock/auto accounts only by default.
ATTENDANCE_AUTOMATION_TEST_ENABLED=true
ATTENDANCE_AUTOMATION_TEST_USERNAMES=17770113605
ATTENDANCE_AUTOMATION_TEST_ALLOW_NON_TEST_USERS=true
ATTENDANCE_AUTOMATION_TEST_LONGITUDE=113.76957489705129
ATTENDANCE_AUTOMATION_TEST_LATITUDE=23.099596024527226
ATTENDANCE_AUTOMATION_TEST_CHECK_IN_START=08:20:00
ATTENDANCE_AUTOMATION_TEST_CHECK_IN_END=08:30:00
ATTENDANCE_AUTOMATION_TEST_CHECK_OUT_START=18:00:00
ATTENDANCE_AUTOMATION_TEST_CHECK_OUT_END=18:10:00
ATTENDANCE_AUTOMATION_TEST_WORKER_INTERVAL_MS=60000

# SMS配置
SMS_MCH_ID=""
SMS_APP_ID=""
SMS_SIGN_NAME=""
SMS_SECRET_KEY=""

# 登录验证码相关参数
LOGIN_SMS_CODE_LENGTH=6
LOGIN_SMS_CODE_TTL=300
LOGIN_SMS_RESEND_INTERVAL=60
LOGIN_SMS_MAX_VERIFY_ATTEMPTS=5

# 微信支付（测试用）
WECHAT_OPEN_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=.wechat/pub_key.pem
WECHAT_PAY_PRIVATE_KEY_PATH=.wechat/apiclient_key.pem

# redis
REDIS_URL="redis://127.0.0.1:6379"

# ssh隧道命令
# ssh -N -L 3307:127.0.0.1:3306 -L 6379:127.0.0.1:6379 {隧道用户}@{ip} -i {公钥路径}
