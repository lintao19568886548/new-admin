{
  "name": "@vben/backend-mock",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm run generate && nitro build && node ./scripts/tar-nitro-output.mjs",
    "start": "pnpm run generate && nitro dev",
    "generate": "pnpm run prisma:generate",
    "migrate:deploy": "pnpm run migrate:check-safe && pnpm exec prisma migrate deploy",
    "migrate:dev": "pnpm exec prisma migrate dev",
    "push": "pnpm run prisma:push",
    "push:multi": "node ./scripts/prisma-push-multi.mjs",
    "push:multi:execute": "node ./scripts/prisma-push-multi.mjs --execute",
    "push:notices": "pnpm run prisma:push:notices",
    "prisma:generate": "pnpm exec prisma generate && pnpm run prisma:generate:center && pnpm run prisma:generate:notices",
    "prisma:generate:center": "pnpm exec cross-env PRISMA_TARGET=center prisma generate",
    "prisma:generate:notices": "pnpm exec cross-env PRISMA_TARGET=notices prisma generate",
    "prisma:push": "pnpm exec prisma db push",
    "prisma:push:center": "pnpm exec cross-env PRISMA_TARGET=center prisma db push",
    "prisma:push:notices": "pnpm exec cross-env PRISMA_TARGET=notices prisma db push",
    "menu-template:backfill-keys": "node ./scripts/backfill-menu-template-keys.mjs",
    "tenant-provisioning:requeue-failed-manual": "node ./scripts/requeue-failed-manual-tenant-provisioning.mjs",
    "vip-membership:migrate-legacy": "node ./scripts/migrate-legacy-vip-membership.mjs",
    "trial:reset-public": "node ./scripts/reset-public-trial-start.mjs"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^2.0.24",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@faker-js/faker": "catalog:",
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@prisma/client-runtime-utils": "^7.6.0",
    "axios": "^1.13.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "db0": "^0.3.4",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "catalog:",
    "mariadb": "^3.4.5",
    "ms": "^2.1.3",
    "mysql2": "^3.16.1",
    "nzh": "^1.0.14",
    "pinyin-pro": "^3.28.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "catalog:",
    "h3": "catalog:",
    "nitropack": "^2.13.1",
    "prisma": "^7.6.0"
  }
}
