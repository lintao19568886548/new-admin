// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id       Int        @id @default(autoincrement())
  realName String     @db.VarChar(30) @map("real_name")
  username String     @db.VarChar(50)
  password String     @db.VarChar(100)
  roles    String     @db.VarChar(20)
  homePath String?    @db.VarChar(100) @map("home_path")
  userCodes UserCode[] @relation("UserToUserCode")

  @@map("user")
}

model UserCode {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(100)
  userId    Int      @map("user_id")
  user      User     @relation("UserToUserCode", map: "user_code_no_fk", fields: [userId], references: [id])

  @@index([userId])
  @@map("user_code")
}

model Tenant {
  tenantId    Int     @id @default(autoincrement()) @map("tenant_id")
  tenantName  String @db.VarChar(30) @map("tenant_name")
  amountBills AmountBill[] @relation("AmountBillToTenant")

  @@map("tenant")
}

model AmountBill {
  billId               Int       @id @default(autoincrement()) @map("bill_id")
  tenantName            String    @map("tenant_name")
  eleFee               Decimal?  @db.Decimal(10, 2) @map("ele_fee")
  waterFee             Decimal?  @db.Decimal(10, 2) @map("water_fee")
  factoryRent          Decimal?  @db.Decimal(10, 2) @map("factory_rent")
  managementFee        Decimal?  @db.Decimal(10, 2) @map("management_fee")
  serviceFee           Decimal?  @db.Decimal(10, 2) @map("service_fee")
  invoiceTax           Decimal?  @db.Decimal(10, 2) @map("invoice_tax")
  totalFee             Decimal?  @db.Decimal(10, 2) @map("total_fee")
  createTime           DateTime? @map("create_time")
  receiptTime          DateTime? @map("receipt_time")
  tenantId             Int       @map("tenant_id")
  tenant               Tenant    @relation("AmountBillToTenant", map: "tenant_no_fk", fields: [tenantId], references: [tenantId])
  eleBills             EleBill[] @relation("EleBillToAmountBill")
  waterBills           WaterBill[] @relation("WaterBillToAmountBill")

  @@index([tenantId])
  @@map("amount_bill")
}

model EleBill {
  eleId           Int       @id @default(autoincrement()) @db.Int @map("ele_id")
  billId          Int       @map("bill_id")
  meterName       String   @map("meter_name")
  previousReading Decimal?  @db.Decimal(10, 2) @map("previous_reading")
  currentReading  Decimal?  @db.Decimal(10, 2) @map("current_reading")
  monthlyUsage    Decimal?  @db.Decimal(10, 2) @map("monthly_usage")
  multiplier      Decimal?  @db.Decimal(10, 2)
  totalUsage      Decimal?  @db.Decimal(10, 2) @map("total_usage")
  unitPrice       Float?    @db.Float @map("unit_price")
  amount          Decimal?  @db.Decimal(10, 2)
  remarks         String?
  createTime      DateTime @map("create_time")
  receiptTime     DateTime @map("receipt_time")
  amountBill      AmountBill @relation("EleBillToAmountBill", map: "ele_bill_no_fk", fields: [billId], references: [billId])

  @@index([billId])
  @@map("ele_bill")
}

model WaterBill {
  waterId         Int       @id @default(autoincrement()) @map("water_id")
  billId          Int      @map("bill_id")
  meterName       String   @map("meter_name")
  previousReading Decimal?  @db.Decimal(10, 2) @map("previous_reading")
  currentReading  Decimal?  @db.Decimal(10, 2) @map("current_reading")
  monthlyUsage    Decimal?  @db.Decimal(10, 2) @map("monthly_usage")
  multiplier      Decimal?  @db.Decimal(10, 2)
  totalUsage      Decimal?  @db.Decimal(10, 2) @map("total_usage")
  unitPrice       Float?    @db.Float @map("unit_price")
  amount          Decimal?  @db.Decimal(10, 2)
  remarks         String?
  createTime      DateTime @map("create_time")
  receiptTime     DateTime @map("receipt_time")
  amountBill      AmountBill? @relation("WaterBillToAmountBill", map: "water_bill_no_fk", fields: [billId], references: [billId])

  @@index([billId])
  @@map("water_bill")
}

model Car {
  carId    Int     @id @map("car_id")
  carNum   String  @db.LongText @map("car_num")
  status   Int
  time     Int
  remark   String? @db.LongText

  @@map("car")
}

model Finance {
  financeId              Int    @id @default(autoincrement()) @map("finance_id")
  billName        String    @db.VarChar(100) @map("bill_name")
  billCategory    String    @db.VarChar(50) @map("bill_category")
  amount          Decimal   @db.Decimal(10, 2)
  transactionType String    @db.VarChar(20) @map("transaction_type")
  transactionTime DateTime  @map("transaction_time")
  remark          String?   @db.Text
  createTime      DateTime  @default(now()) @map("create_time")
  updateTime      DateTime  @updatedAt @map("update_time")

  @@map("finance")
}
