// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id              Int         @id @default(autoincrement())
  realName        String      @db.VarChar(30) @map("real_name")
  username        String      @db.VarChar(50) @unique
  password        String      @db.VarChar(100)
  roleId          Int?        @map("role_id")
  role            Role?       @relation(fields: [roleId], references: [roleId])
  homePath        String?     @db.VarChar(100) @map("home_path")
  userCodes       UserCode[]  @relation("UserToUserCode")
  createTime      DateTime?   @default(now()) @map("create_time")
  updateTime      DateTime?   @updatedAt @map("update_time")

  @@index([roleId])
  @@map("user")
}

model UserCode {
  id             Int         @id @default(autoincrement())
  code           String      @db.VarChar(100)
  userId         Int         @map("user_id")
  user           User        @relation("UserToUserCode", map: "user_code_no_fk", fields: [userId], references: [id])
  createTime     DateTime?   @default(now()) @map("create_time")
  updateTime     DateTime    @updatedAt @map("update_time")

  @@index([userId])
  @@map("user_code")
}

model Menu {
  menuId          Int          @id @default(autoincrement()) @map("menu_id")
  name            String       @db.VarChar(50)
  type            String       
  status          Int          @default(1)
  path            String       @db.VarChar(50)
  activePath      String?      @db.VarChar(100) @map("active_path")
  redirect        String?      @db.VarChar(100)
  component       String?      @db.VarChar(100)      
  pid             Int?         
  authCode        String?      @db.VarChar(100) @map("auth_code")
  roleMenus       RoleMenu[]   @relation("MenuToRoleMenu")
  children        Menu[]       @relation("MenuToMenu")
  parent          Menu?        @relation("MenuToMenu", fields: [pid], references: [menuId], onDelete: NoAction, onUpdate: NoAction)
  meta            MenuMeta?    @relation("MenuToMenuMeta")

  @@index([pid])
}

model MenuMeta {
  metaId              Int       @id @default(autoincrement()) @map("meta_id")
  title               String    @db.VarChar(100)
  icon                String?   @db.VarChar(100)
  order               Int?      
  activeIcon          String?   @db.VarChar(100) @map("active_icon")
  activePath          String?   @db.VarChar(100) @map("active_path")
  affixTab            Boolean?  @map("affix_tab")
  affixTabOrder       Int?      @map("affix_tab_order")
  badge               String?   @db.VarChar(50)  @map("badge_content")
  badgeType           String?   @db.VarChar(20)  @map("badge_type")
  badgeVariants       String?   @db.VarChar(20)  @map("badge_variants")
  hideChildrenInMenu  Boolean?  @map("hide_children_in_menu")
  hideInBreadcrumb    Boolean?  @map("hide_in_breadcrumb")
  hideInMenu          Boolean?  @map("hide_in_menu")
  hideInTab           Boolean?  @map("hide_in_tab")
  iframeSrc           String?   @db.VarChar(100) @map("iframe_src")
  keepAlive           Boolean?  @map("keep_alive")
  link                String?   @db.VarChar(200)
  maxNumOfOpenTab     Int?      @map("max_num_of_open_tab")
  noBasicLayout       Boolean?  @map("no_basic_layout")
  openInNewWindow     Boolean?  @map("open_in_new_window")
  menuId              Int       @unique @map("menu_id")
  menu                Menu      @relation("MenuToMenuMeta", fields: [menuId], references: [menuId], onDelete: Cascade)

  @@index([menuId])
  @@map("menu_meta")
}

model Role {
  roleId          Int          @id @default(autoincrement()) @map("role_id")
  name            String?      @db.VarChar(50)
  remark          String?      @db.VarChar(100)
  status          Boolean          
  createTime      DateTime?    @default(now()) @map("create_time")
  updateTime      DateTime?    @updatedAt @map("update_time")
  roleMenus       RoleMenu[]   @relation("RoleToRoleMenu")
  users           User[]
}

// 角色菜单关联表
model RoleMenu {
  id              Int          @id @default(autoincrement())
  roleId          Int          @map("role_id")
  menuId          Int          @map("menu_id")
  role            Role         @relation("RoleToRoleMenu", fields: [roleId], references: [roleId])
  menu            Menu         @relation("MenuToRoleMenu", fields: [menuId], references: [menuId])
  createTime      DateTime?    @default(now()) @map("create_time")
  updateTime      DateTime?    @updatedAt @map("update_time")

  @@index([roleId])
  @@index([menuId])
  @@map("role_menu")
}

model AmountBill {
  billId               Int               @id @default(autoincrement()) @map("bill_id")
  projectName          String?           @map("project_name")
  tenantName           String            @map("tenant_name")
  eleFee               Decimal?          @db.Decimal(10, 2) @map("ele_fee")
  waterFee             Decimal?          @db.Decimal(10, 2) @map("water_fee")
  factoryRent          Decimal?          @db.Decimal(10, 2) @map("factory_rent")
  managementFee        Decimal?          @db.Decimal(10, 2) @map("management_fee")
  serviceFee           Decimal?          @db.Decimal(10, 2) @map("service_fee")
  invoiceTax           Decimal?          @db.Decimal(10, 2) @map("invoice_tax")
  totalFee             Decimal?          @db.Decimal(10, 2) @map("total_fee")
  tenantId             Int?              @map("tenant_id")
  remark               String?           @db.VarChar(100)
  receiptTime          DateTime?         @map("receipt_time")
  createTime           DateTime?         @default(now()) @map("create_time")
  updateTime           DateTime?         @updatedAt @map("update_time")
  tenant               RentalTenant?     @relation("AmountBillToTenant", map: "tenant_no_fk", fields: [tenantId], references: [rentalTenantId])
  eleBills             EleBill[]         @relation("EleBillToAmountBill")
  waterBills           WaterBill[]       @relation("WaterBillToAmountBill")

  @@index([tenantId])
  @@map("amount_bill")
}

model EleBill {
  eleId           Int        @id @default(autoincrement()) @db.Int @map("ele_id")
  billId          Int        @map("bill_id")
  meterName       String     @map("meter_name")
  previousReading Decimal?   @db.Decimal(10, 2) @map("previous_reading")
  currentReading  Decimal?   @db.Decimal(10, 2) @map("current_reading")
  monthlyUsage    Decimal?   @db.Decimal(10, 2) @map("monthly_usage")
  multiplier      Decimal?   @db.Decimal(10, 2)
  totalUsage      Decimal?   @db.Decimal(10, 2) @map("total_usage")
  unitPrice       Float?     @db.Float @map("unit_price")
  amount          Decimal?   @db.Decimal(10, 2)
  remark          String?    @db.VarChar(100)
  receiptTime     DateTime   @map("receipt_time")
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")
  amountBill      AmountBill @relation("EleBillToAmountBill", map: "ele_bill_no_fk", fields: [billId], references: [billId])

  @@index([billId])
  @@map("ele_bill")
}

model WaterBill {
  waterId         Int         @id @default(autoincrement()) @map("water_id")
  billId          Int         @map("bill_id")
  meterName       String      @map("meter_name")
  previousReading Decimal?    @db.Decimal(10, 2) @map("previous_reading")
  currentReading  Decimal?    @db.Decimal(10, 2) @map("current_reading")
  monthlyUsage    Decimal?    @db.Decimal(10, 2) @map("monthly_usage")
  multiplier      Decimal?    @db.Decimal(10, 2)
  totalUsage      Decimal?    @db.Decimal(10, 2) @map("total_usage")
  unitPrice       Float?      @db.Float @map("unit_price")
  amount          Decimal?    @db.Decimal(10, 2)
  remark          String?     @db.VarChar(100)
  receiptTime     DateTime    @map("receipt_time")
  createTime      DateTime?   @default(now()) @map("create_time")
  updateTime      DateTime?   @updatedAt @map("update_time")
  amountBill      AmountBill? @relation("WaterBillToAmountBill", map: "water_bill_no_fk", fields: [billId], references: [billId])

  @@index([billId])
  @@map("water_bill")
}

model Visitor {
  visitorId        Int       @id @default(autoincrement()) @map("visitor_id")
  visitorName      String    @db.VarChar(50) @map("visitor_name")
  carNum           String?   @db.LongText @map("car_num")
  phoneNumber      String    @db.LongText @map("phone_number")
  status           Int       // 0: 进入, 1: 离开
  registerTime     DateTime  @map("register_time") // 将 Int 改为 DateTime 类型，更适合存储时间
  remark           String?   @db.VarChar(100)
  createTime       DateTime  @default(now()) @map("create_time")
  updateTime       DateTime  @updatedAt @map("update_time")

  @@map("visitor")
}

// 车辆出入管理模型 (access/car)
model Car {
  carId           Int        @id @default(autoincrement()) @map("car_id")
  carNumber       String     @db.VarChar(20) @map("car_number")
  accessStatus    Int        @map("access_status") // 1: 进入, 0: 离开
  registerTime    DateTime   @map("register_time")
  remark          String?    @db.VarChar(200)
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")

  @@map("car")
}

model Finance {
  financeId       Int        @id @default(autoincrement()) @map("finance_id")
  billName        String     @db.VarChar(100) @map("bill_name")
  billCategory    String     @db.VarChar(50) @map("bill_category")
  amount          Decimal    @db.Decimal(10, 2)
  transactionType String     @db.VarChar(20) @map("transaction_type")
  transactionTime DateTime   @map("transaction_time")
  remark          String?    @db.VarChar(100)
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")

  @@map("finance")
}

// 投资代理模型 (investment/agent)
model Investment {
  investmentId    Int        @id @default(autoincrement()) @map("investment_id")
  agentName       String     @db.VarChar(100) @map("agent_name")
  tenantName      String     @db.VarChar(100) @map("tenant_name")
  intentLevel     String     @db.VarChar(50) @map("intent_level")
  intentArea      Int        @map("intent_area")
  progress        String     @db.VarChar(30)
  phoneNumber     String     @db.VarChar(11) @map("phone_number")
  meetingTime     DateTime   @map("meeting_time")
  remark          String?    @db.VarChar(100)
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")

  @@map("investment")
}

// 投资租户模型 (investment/tenant)
model InvestmentTenant {
  tenantId        Int        @id @default(autoincrement()) @map("tenant_id")
  billName        String     @db.VarChar(100) @map("bill_name")
  billCategory    String     @db.VarChar(50) @map("bill_category")
  amount          Decimal    @db.Decimal(10, 2)
  transactionType String     @db.VarChar(20) @map("transaction_type")
  transactionTime DateTime   @map("transaction_time")
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")

  @@map("investment_tenant")
}

// 消防设施模型 (maintenance/firefighting)
model Firefighting {
  firefightingId    Int        @id @default(autoincrement()) @map("firefighting_id")
  title             String     @db.VarChar(100)
  address           String     @db.VarChar(200)
  extinguisher      String     @db.VarChar(10)
  fireExit          String     @db.VarChar(100) @map("fire_exit")
  checker           String     @db.VarChar(10)
  maintenanceTime   DateTime   @map("maintenance_time")
  remark            String?    @db.VarChar(100)
  createTime        DateTime?  @default(now()) @map("create_time")
  updateTime        DateTime?  @updatedAt @map("update_time")

  @@map("firefighting")
}

// 变压器模型 (maintenance/transformer)
model Transformer {
  transformerId   Int        @id @default(autoincrement()) @map("transformer_id")
  title           String     @db.VarChar(100)
  address         String     @db.VarChar(200)
  contact         String     @db.VarChar(100)
  status          String     @db.VarChar(20) // 变压器状态：正常、异常、维护中
  specifications  String     @db.VarChar(50) // 变压器规格
  remark          String?    @db.VarChar(100)
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")

  @@map("transformer")
}

// 租赁管理模型 (rental/manage)
model RentalManage {
  rentalManageId  Int        @id @default(autoincrement()) @map("rental_manage_id")
  title           String     @db.VarChar(100)
  address         String     @db.VarChar(200)
  area            String     @db.VarChar(50) // 总面积
  availableArea   String     @db.VarChar(50) @map("available_area") // 可用面积
  price           Decimal    @db.Decimal(10, 2) // 价格
  contact         String     @db.VarChar(100) // 联系人
  remark          String?    @db.VarChar(100)
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")

  @@map("rental_manage")
}

// 租户管理模型 (rental/tenant)
model RentalTenant {
  rentalTenantId    Int           @id @default(autoincrement()) @map("rental_tenant_id")
  tenantName        String        @db.VarChar(30) @map("tenant_name")
  phoneNumber       String        @db.VarChar(20) @map("phone_number")
  status            String        @db.VarChar(20)  // 当期、过期等状态
  contractDate      DateTime      @map("contract_date")
  increaseDate      DateTime      @map("increase_date")
  increaseRate      Decimal       @db.Decimal(5, 2) @map("increase_rate")
  address           String        @db.VarChar(200)
  amountBills       AmountBill[]  @relation("AmountBillToTenant")
  createTime        DateTime?     @default(now()) @map("create_time")
  updateTime        DateTime?     @updatedAt @map("update_time")

  @@map("rental_tenant")
}
