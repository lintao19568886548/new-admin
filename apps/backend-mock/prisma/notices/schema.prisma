generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../../node_modules/@prisma/.prisma/notices-client"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model Notice {
  noticeId    String   @id @map("notice_id") @db.VarChar(64)
  title       String?  @db.VarChar(512)
  date        String?  @db.VarChar(32)
  type        String?  @db.VarChar(64)
  category    String?  @db.VarChar(64)
  projectType String?  @map("project_type") @db.VarChar(128)
  siteCode    String?  @map("site_code") @db.VarChar(32)
  owner       String?  @db.VarChar(256)
  platform    String?  @db.VarChar(256)
  link        String?  @db.Text
  isValid     Boolean  @default(true) @map("is_valid")
  invalidReason String? @map("invalid_reason") @db.VarChar(255)
  lastCheckedAt DateTime? @map("last_checked_at") @db.DateTime(0)
  createdAt   DateTime @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @map("updated_at") @db.DateTime(0)

  @@index([isValid])
  @@index([lastCheckedAt])
  @@index([date])
  @@map("notices")
}
