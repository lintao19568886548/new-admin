model User {
  id                     Int                    @id @default(autoincrement())
  realName               String                 @map("real_name") @db.VarChar(30)
  username               String                 @unique @db.VarChar(50)
  password               String                 @db.VarChar(100)
  customerType           String?                @map("customer_type") @db.VarChar(50)
  status                 Int?                   @default(1) @db.TinyInt
  tokenVersion           Int                    @default(1) @map("token_version")
  phone                  String?                @db.VarChar(20)
  homePath               String?                @map("home_path") @db.VarChar(100)
  membershipTrialStartAt DateTime?              @map("membership_trial_start_at")
  customerMappings       UserCustomerMapping[]  @relation("UserToCustomerMapping")
  refreshTokens          RefreshToken[]         @relation("UserToRefreshToken")
  vipMembershipPayments  VipMembershipPayment[] @relation("CenterUserToVipMembershipPayment")
  createTime             DateTime?              @default(now()) @map("create_time")
  updateTime             DateTime?              @updatedAt @map("update_time")

  @@map("user")
}

model UserCustomerMapping {
  id             Int       @id @default(autoincrement())
  centerUserId   Int       @map("center_user_id")
  customerId     String    @map("customer_id") @db.VarChar(50)
  customerUserId Int       @map("customer_user_id")
  dbName         String?   @map("db_name") @db.VarChar(100)
  user           User      @relation("UserToCustomerMapping", map: "user_tenant_mapping_no_fk", fields: [centerUserId], references: [id])
  createTime     DateTime? @default(now()) @map("create_time")
  updateTime     DateTime? @updatedAt @map("update_time")

  @@unique([centerUserId, customerId])
  @@unique([customerId, customerUserId])
  @@index([customerId])
  @@map("user_tenant_mapping")
}

model Customer {
  customerId       String    @id @map("customer_id") @db.VarChar(50)
  name             String    @db.VarChar(100)
  city             String?   @db.VarChar(30)
  companyShortName String?   @map("company_short_name") @db.VarChar(50)
  code             String?   @unique @db.VarChar(50)
  status           Int       @default(1) @db.TinyInt
  dbName           String?   @map("db_name") @db.VarChar(100)
  createTime       DateTime  @default(now()) @map("create_time")
  updateTime       DateTime? @updatedAt @map("update_time")

  @@index([status])
  @@map("customer")
}

model RefreshToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  user          User      @relation("UserToRefreshToken", map: "refresh_token_no_fk", fields: [userId], references: [id])
  jti           String    @unique @db.VarChar(64)
  tokenHash     String    @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedByJti String?   @map("replaced_by_jti") @db.VarChar(64)
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  createTime    DateTime? @default(now()) @map("create_time")
  updateTime    DateTime? @updatedAt @map("update_time")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}
