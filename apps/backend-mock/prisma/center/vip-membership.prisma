model VipMembership {
  id                    Int       @id @default(autoincrement())
  customerId            String    @unique @map("customer_id") @db.VarChar(50)
  status                String    @default("active") @db.VarChar(20)
  expireAt              DateTime  @map("expire_at")
  lastPayerCenterUserId Int?      @map("last_payer_center_user_id")
  lastOutTradeNo        String?   @map("last_out_trade_no") @db.VarChar(64)
  lastTransactionId     String?   @map("last_transaction_id") @db.VarChar(64)
  createTime            DateTime? @default(now()) @map("create_time")
  updateTime            DateTime? @updatedAt @map("update_time")

  @@index([lastPayerCenterUserId])
  @@map("vip_membership")
}

model VipMembershipPayment {
  id                     Int       @id @default(autoincrement())
  outTradeNo             String    @unique @map("out_trade_no") @db.VarChar(64)
  centerUserId           Int       @map("center_user_id")
  user                   User      @relation("CenterUserToVipMembershipPayment", fields: [centerUserId], references: [id])
  sourceCustomerId       String    @map("source_customer_id") @db.VarChar(50)
  targetCustomerId       String?   @map("target_customer_id") @db.VarChar(50)
  targetCity             String?   @map("target_city") @db.VarChar(30)
  targetCompanyShortName String?   @map("target_company_short_name") @db.VarChar(50)
  username               String?   @db.VarChar(50)
  amountTotal            Int       @default(0) @map("amount_total")
  tradeState             String    @default("NOTPAY") @map("trade_state") @db.VarChar(32)
  transactionId          String?   @map("transaction_id") @db.VarChar(64)
  paidAt                 DateTime? @map("paid_at")
  appliedAt              DateTime? @map("applied_at")
  rawAttach              String?   @map("raw_attach") @db.LongText
  createTime             DateTime? @default(now()) @map("create_time")
  updateTime             DateTime? @updatedAt @map("update_time")

  @@index([centerUserId])
  @@index([sourceCustomerId])
  @@map("vip_membership_payment")
}

model TenantProvisioningJob {
  id                     Int       @id @default(autoincrement())
  initiatorCenterUserId  Int       @map("initiator_center_user_id") // 发起人中心用户ID
  sourceCustomerId       String    @map("source_customer_id") @db.VarChar(50) // 源客户ID
  targetCustomerId       String?   @map("target_customer_id") @db.VarChar(50) // 目标客户ID
  targetCity             String?   @map("target_city") @db.VarChar(30) // 目标城市
  targetCompanyShortName String?   @map("target_company_short_name") @db.VarChar(50) // 目标公司简称
  targetDbName           String?   @map("target_db_name") @db.VarChar(100) // 目标数据库名称
  status                 String    @default("pending") @db.VarChar(32) // 状态
  step                   String?   @db.VarChar(64) // 当前步骤
  retryCount             Int       @default(0) @map("retry_count") // 重试次数
  lastPaymentOutTradeNo  String?   @map("last_payment_out_trade_no") @db.VarChar(64) // 最后支付订单号
  errorMessage           String?   @map("error_message") @db.LongText // 错误信息
  lockOwner              String?   @map("lock_owner") @db.VarChar(128) // 锁所有者
  lockedAt               DateTime? @map("locked_at") // 锁定时间
  heartbeatAt            DateTime? @map("heartbeat_at") // 心跳时间
  startedAt              DateTime? @map("started_at") // 开始时间
  completedAt            DateTime? @map("completed_at") // 完成时间
  createTime             DateTime? @default(now()) @map("create_time")
  updateTime             DateTime? @updatedAt @map("update_time")

  @@unique([targetCustomerId])
  @@index([initiatorCenterUserId])
  @@index([sourceCustomerId])
  @@index([status])
  @@index([status, heartbeatAt])
  @@index([lockOwner])
  @@index([targetDbName])
  @@map("tenant_provisioning_job")
}
