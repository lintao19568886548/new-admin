model Reimbursement {
  id           Int                  @id @default(autoincrement())
  purpose      String               @db.VarChar(100) // 报销事由
  amount       Decimal              @db.Decimal(15, 2) // 报销金额
  payee        String               @db.VarChar(50) // 收款人
  date         DateTime             @default(now()) // 报销日期
  department   String?              @db.VarChar(50)
  username     String?              @db.VarChar(50)
  remark       String?              @db.VarChar(200)
  createTime   DateTime?            @default(now()) @map("create_time")
  updateTime   DateTime?            @updatedAt @map("update_time")
  status       Int                  @default(0)
  isDeleted    Boolean              @default(false) @map("is_deleted")
  userId       Int?                 @map("user_id") // 申请账号
  user         User?                @relation("UserToReimbursement",fields: [userId], references: [id])
  parkId       Int?                 @map("park_id")
  park         Park?                @relation("ParkToReimbursement", fields: [parkId], references: [parkId])
  images       ReimbursementImage[] @relation("ReimbursementToReimbursementImage")
  auditOpinion String?              @db.VarChar(200)
  claimant     String?              //旧字段


  @@index([parkId])
  @@index([parkId, status, isDeleted, createTime], map: "reimbursement_park_status_deleted_create_time_idx")
  @@index([userId, isDeleted, createTime], map: "reimbursement_user_deleted_create_time_idx")
  @@index([userId])
  @@index([username])
  @@map("reimbursement")
}
