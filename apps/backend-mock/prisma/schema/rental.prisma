// 租户管理模型 (rental/tenant)
model RentalTenant {
  rentalTenantId Int          @id @default(autoincrement()) @map("rental_tenant_id")
  tenantName     String       @map("tenant_name") @db.VarChar(30)
  phoneNumber    String       @map("phone_number") @db.VarChar(20)
  status         String?      @db.VarChar(20) /// 当期、过期等状态
  contractStart  DateTime?    @map("contract_start")
  contractEnd    DateTime?    @map("contract_end")
  rent           Decimal?     @map("rental_amount") @db.Decimal(10, 2)
  increaseDate   DateTime?    @map("increase_date")
  increaseRate   Decimal?     @map("increase_rate") @db.Decimal(5, 2)
  penaltyRate    Decimal?     @map("penalty_rate") @db.Decimal(5, 2)
  area           Decimal?     @map("area") @db.Decimal(10, 2)
  address        String       @db.VarChar(200)
  remark         String?      @db.VarChar(500)
  createTime     DateTime?    @default(now()) @map("create_time")
  updateTime     DateTime?    @updatedAt @map("update_time")
  amountBills    AmountBill[] @relation("AmountBillToTenant")
  parkId         Int?         @map("park_id")
  park           Park?        @relation("ParkToRentalTenant", fields: [parkId], references: [parkId])
  isDeleted      Boolean      @default(false) @map("is_deleted")

  @@index([parkId])
  @@map("rental_tenant")
}
