// 园区表
model Park {
  parkId        Int               @id @default(autoincrement()) @map("park_id")
  parkName      String            @map("park_name") @db.VarChar(100)
  address       String            @db.VarChar(200)
  area          Decimal?          @db.Decimal(10, 2) // 总面积(平方米)
  description   String?           @db.Text
  status        String            @db.VarChar(20) // 状态：运营中、建设中、规划中等
  factories     Factory[]         @relation("ParkToFactory")
  dormitories   Dormitory[]       @relation("ParkToDormitory")
  roleParks     RolePark[]        @relation("ParkToRolePark")
  amountBills   AmountBill[]      @relation("ParkToAmountBill")
  finances      Finance[]         @relation("ParkToFinance")
  visitors      AccessVisitor[]   @relation("ParkToVisitor")
  cars          AccessCar[]       @relation("ParkToCar")
  investments   Investment[]      @relation("ParkToInvestment")
  firefighting  Firefighting[]    @relation("ParkToFirefighting")
  transformers  Transformer[]     @relation("ParkToTransformer")
  // 移除 rentalManages 关系，因为已合并到 factories
  rentalTenants RentalTenant[]    @relation("ParkToRentalTenant")
  createTime    DateTime?         @default(now()) @map("create_time")
  updateTime    DateTime?         @updatedAt @map("update_time")

  @@map("park")
}

// 厂房表 (合并了 RentalManage 的字段)
model Factory {
  factoryId      Int            @id @default(autoincrement()) @map("factory_id")
  factoryName    String         @map("factory_name") @db.VarChar(100)
  parkId         Int            @map("park_id")
  park           Park           @relation("ParkToFactory", fields: [parkId], references: [parkId])
  buildingNumber String         @map("building_number") @db.VarChar(50) // 楼号
  floorCount     Int            @map("floor_count") // 层数
  area           Decimal        @db.Decimal(10, 2) // 总面积(平方米)
  availableArea  Decimal        @db.Decimal(10, 2) @map("available_area") // 可用面积(平方米)
  status         String?        @map("status") @db.VarChar(20) // 一般为空，特殊状态才设置，如：维护中
  rentPrice      Decimal        @map("rent_price") @db.Decimal(10, 2) // 租金(元/平方米/月)
  buildTime      DateTime       @db.Date @map("build_time") // 建造年份
  address        String         @db.VarChar(200) // 详细地址
  contact        String         @db.VarChar(100) // 联系人
  description    String?        @db.Text // 描述
  images         FactoryImage[] @relation("FactoryToFactoryImage")
  createTime     DateTime       @default(now()) @map("create_time")
  updateTime     DateTime?      @updatedAt @map("update_time")

  @@index([parkId])
  @@map("factory")
}

// 宿舍表
model Dormitory {
  dormitoryId    Int       @id @default(autoincrement()) @map("dormitory_id")
  parkId         Int       @map("park_id")
  park           Park      @relation("ParkToDormitory", fields: [parkId], references: [parkId])
  roomNumber     String    @map("room_number") @db.VarChar(50) // 房间号
  buildingNumber String    @map("building_number") @db.VarChar(50) // 楼号
  floorCount     Int?      @map("floor_count") // 层数
  capacity       Int? // 容纳人数
  occupancy      Int? // 当前入住人数
  rentPrice      Decimal?  @map("rent_price") @db.Decimal(10, 2) // 租金(元/床位/月)
  facilities     String?   @db.Text // 设施描述
  description    String?   @db.Text
  createTime     DateTime? @default(now()) @map("create_time")
  updateTime     DateTime? @updatedAt @map("update_time")

  @@index([parkId])
  @@map("dormitory")
}
