model Role {
  roleId            Int        @id @default(autoincrement()) @map("role_id")
  name              String?    @db.VarChar(50)
  remark            String?    @db.VarChar(100)
  status            Boolean
  parentId          Int?       @map("parent_id")
  createTime        DateTime?  @default(now()) @map("create_time")
  updateTime        DateTime?  @updatedAt @map("update_time")
  roleMenus         RoleMenu[] @relation("RoleToRoleMenu")
  userRoles         UserRole[] @relation("RoleToUserRole")
  roleParks         RolePark[] @relation("RoleToRolePark")
  roleCodes         RoleCode[] @relation("RoleToRoleCode")
  reimbursementAuth Int?       @map("reimbursement_auth")
  rates             Int?       @map("rates")
  children          Role[]     @relation("RoleToRole")
  parent            Role?      @relation("RoleToRole", fields: [parentId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)

  @@index([parentId])
  @@map("role")
}

// 权限编码表
model Code {
  codeId     Int        @id @default(autoincrement()) @map("code_id")
  code       String     @db.VarChar(50)
  name       String     @db.VarChar(50)
  content    String?    @db.VarChar(100)
  menuId     Int?       @unique @map("menu_id") // 与菜单的一对一关联
  templateKey       String?   @unique @map("template_key") @db.VarChar(191)
  templateVersion   Int       @default(1) @map("template_version")
  templateManaged   Boolean   @default(false) @map("template_managed")
  templateInternalOnly Boolean @default(false) @map("template_internal_only")
  templateDeletedAt DateTime? @map("template_deleted_at")
  menu       Menu?      @relation("MenuToCode", fields: [menuId], references: [menuId], onDelete: Cascade)
  roleCodes  RoleCode[] @relation("CodeToRoleCode")
  createTime DateTime?  @default(now()) @map("create_time")
  updateTime DateTime?  @updatedAt @map("update_time")

  @@index([codeId])
  @@index([menuId])
  @@index([templateManaged, templateInternalOnly, templateDeletedAt])
  @@index([templateManaged, templateDeletedAt])
  @@map("code")
}

// 用户角色关联表
model UserRole {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  roleId     Int       @map("role_id")
  user       User      @relation("UserToUserRole", fields: [userId], references: [id])
  role       Role      @relation("RoleToUserRole", fields: [roleId], references: [roleId], onDelete: Cascade) // 添加 onDelete: Cascade 以允许级联删除
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

// 角色菜单关联表
model RoleMenu {
  id         Int       @id @default(autoincrement())
  roleId     Int       @map("role_id")
  menuId     Int       @map("menu_id")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  role       Role      @relation("RoleToRoleMenu", fields: [roleId], references: [roleId], onDelete: Cascade) // 添加 onDelete: Cascade 以允许级联删除
  menu       Menu      @relation("MenuToRoleMenu", fields: [menuId], references: [menuId], onDelete: Cascade)
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([roleId])
  @@index([menuId])
  @@map("role_menu")
}

// 角色园区关联表(多对多关系)
model RolePark {
  id         Int       @id @default(autoincrement())
  roleId     Int       @map("role_id")
  parkId     Int       @map("park_id")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  role       Role      @relation("RoleToRolePark", fields: [roleId], references: [roleId], onDelete: Cascade) // 添加 onDelete: Cascade 以允许级联删除
  park       Park      @relation("ParkToRolePark", fields: [parkId], references: [parkId])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([roleId])
  @@index([parkId])
  @@map("role_park")
}

// 角色、权限编码关联表
model RoleCode {
  id         Int       @id @default(autoincrement())
  roleId     Int       @map("role_id")
  codeId     Int       @map("code_id")
  role       Role      @relation("RoleToRoleCode", fields: [roleId], references: [roleId], onDelete: NoAction)
  code       Code      @relation("CodeToRoleCode", fields: [codeId], references: [codeId], onDelete: NoAction)
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([roleId])
  @@index([codeId])
  @@map("role_code")
}
