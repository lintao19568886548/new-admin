model Role {
  roleId     Int        @id @default(autoincrement()) @map("role_id")
  name       String?    @db.VarChar(50)
  remark     String?    @db.VarChar(100)
  status     Boolean
  createTime DateTime?  @default(now()) @map("create_time")
  updateTime DateTime?  @updatedAt @map("update_time")
  roleMenus  RoleMenu[] @relation("RoleToRoleMenu")
  userRoles  UserRole[] @relation("RoleToUserRole")
  roleParks  RolePark[] @relation("RoleToPark")
}

// 用户角色关联表
model UserRole {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  roleId     Int       @map("role_id")
  user       User      @relation("UserToUserRole", fields: [userId], references: [id])
  role       Role      @relation("RoleToUserRole", fields: [roleId], references: [roleId])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}

// 角色菜单关联表
model RoleMenu {
  id         Int       @id @default(autoincrement())
  roleId     Int       @map("role_id")
  menuId     Int       @map("menu_id")
  isDeleted  Boolean   @map("is_deleted") @default(false)
  role       Role      @relation("RoleToRoleMenu", fields: [roleId], references: [roleId])
  menu       Menu      @relation("MenuToRoleMenu", fields: [menuId], references: [menuId], onDelete: Cascade)
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")



  @@index([roleId])
  @@index([menuId])
  @@map("role_menu")
}

// 角色园区关联表(多对多关系)
model RolePark {
  id         Int       @id @default(autoincrement())
  roleId     Int       @map("role_id")
  parkId     Int       @map("park_id")
  isDeleted  Boolean   @map("is_deleted") @default(false)
  role       Role      @relation("RoleToPark", fields: [roleId], references: [roleId])
  park       Park      @relation("ParkToRolePark", fields: [parkId], references: [parkId])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([roleId])
  @@index([parkId])
  @@map("role_park")
}
