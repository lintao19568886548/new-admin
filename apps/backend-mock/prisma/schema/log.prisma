// API请求日志模型
model ApiLog {
  logId       Int       @id @default(autoincrement()) @map("log_id")
  method      String    @db.VarChar(10)  // 请求方法：DELETE, POST, PUT等
  path        String    @db.VarChar(255) // 请求路径
  username    String?   @db.VarChar(50)  // 用户名
  requestTime DateTime  @default(now()) @map("request_time") // 请求时间
  createTime  DateTime? @default(now()) @map("create_time")
  updateTime  DateTime? @updatedAt @map("update_time")

  @@map("api_log")
}