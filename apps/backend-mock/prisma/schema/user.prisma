model User {
  id         Int        @id @default(autoincrement())
  realName   String     @map("real_name") @db.VarChar(30)
  username   String     @unique @db.VarChar(50)
  password   String     @db.VarChar(100)
  homePath   String?    @map("home_path") @db.VarChar(100)
  userCodes  UserCode[] @relation("UserToUserCode")
  roles      UserRole[] @relation("UserToUserRole")
  parks      UserPark[] @relation("UserToUserPark")
  createTime DateTime?  @default(now()) @map("create_time")
  updateTime DateTime?  @updatedAt @map("update_time")

  @@map("user")
}

model UserCode {
  id         Int       @id @default(autoincrement())
  code       String    @db.VarChar(100)
  userId     Int       @map("user_id")
  user       User      @relation("UserToUserCode", map: "user_code_no_fk", fields: [userId], references: [id])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime  @updatedAt @map("update_time")

  @@index([userId])
  @@map("user_code")
}

// 用户园区关联表(多对多关系)
model UserPark {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  parkId     Int       @map("park_id")
  user       User      @relation("UserToUserPark", fields: [userId], references: [id])
  park       Park      @relation("ParkToUserPark", fields: [parkId], references: [parkId])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([userId])
  @@index([parkId])
  @@map("user_park")
}

// 用户操作记录模型 (user/operate)
model UserOperate {
  operateId     Int       @id @default(autoincrement()) @map("operate_id")
  userId        Int       @map("user_id")
  operation     String    @db.VarChar(100)
  operationTime DateTime  @map("operation_time")
  remark        String?   @db.VarChar(100)
  createTime    DateTime? @default(now()) @map("create_time")
  updateTime    DateTime? @updatedAt @map("update_time")

  @@map("user_operate")
}
