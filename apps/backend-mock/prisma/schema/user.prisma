model User {
  id                         Int                @id @default(autoincrement())
  realName                   String             @map("real_name") @db.VarChar(30)
  username                   String             @unique @db.VarChar(50)
  password                   String             @db.VarChar(100)
  customerType               String?            @map("customer_type") @db.VarChar(50)
  status                     Int?               @default(1) @db.TinyInt
  tokenVersion               Int                @default(1) @map("token_version")
  phone                      String?            @db.VarChar(20)
  homePath                   String?            @map("home_path") @db.VarChar(100)
  userCodes                  UserCode[]         @relation("UserToUserCode")
  roles                      UserRole[]         @relation("UserToUserRole")
  localizations              Localization[]     @relation("UserToLocalization")
  submittedLeaveApplications LeaveApplication[] @relation("ApplicantLeaveApplications")
  auditedLeaveApplications   LeaveApplication[] @relation("AuditorLeaveApplications")
  reimbursements             Reimbursement[]    @relation("UserToReimbursement")
  feedbacks                  Feedback[]         @relation("UserToFeedback")
  parkId                     Int?               @map("park_id")
  park                       Park?              @relation("ParkToUser", fields: [parkId], references: [parkId])
  attendances                Attendance[]       @relation("UserToAttendance")
  createTime                 DateTime?          @default(now()) @map("create_time")
  updateTime                 DateTime?          @updatedAt @map("update_time")

  @@index([parkId])
  @@map("user")
}

model UserCode {
  id         Int       @id @default(autoincrement())
  code       String    @db.VarChar(100)
  userId     Int       @map("user_id")
  user       User      @relation("UserToUserCode", map: "user_code_no_fk", fields: [userId], references: [id])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime  @updatedAt @map("update_time")

  @@index([userId])
  @@map("user_code")
}
