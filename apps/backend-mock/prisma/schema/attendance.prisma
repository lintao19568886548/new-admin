model Attendance {
  attendanceId Int       @id @default(autoincrement())
  punchIn      DateTime  @default(now())
  punchOut     DateTime?
  status       Int? // e.g., 0: Normal, 1: Late, 2: Early Leave, 3: Late and Early Leave
  longitude    Decimal   @db.Decimal(18, 15) //经度
  latitude     Decimal   @db.Decimal(18, 15) //纬度
  userId       Int?      @map("user_id")
  user         User?     @relation("UserToAttendance", fields: [userId], references: [id])
  username     String    @map("username")

  @@index([userId])
  @@index([status, punchIn])
  @@index([username, punchIn])
  @@index([userId, punchIn])
  @@map("attendances")
}
