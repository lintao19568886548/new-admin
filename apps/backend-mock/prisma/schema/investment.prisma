model LeadScoreRule {
  ruleId          BigInt   @id @default(autoincrement()) @map("rule_id")
  ruleCode        String   @unique @map("rule_code") @db.VarChar(100)
  ruleName        String   @map("rule_name") @db.VarChar(100)
