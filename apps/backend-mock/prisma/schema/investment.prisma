  createTime        DateTime  @default(now()) @map("create_time")
  updateTime        DateTime  @updatedAt @map("update_time")
  isDeleted         Int       @default(0) @map("is_deleted") @db.TinyInt

  @@index([enterpriseId], map: "idx_investment_lead_enterprise")
  @@index([parkId], map: "idx_investment_lead_park")
  @@index([stage], map: "idx_investment_lead_stage")
  @@index([priorityLevel, totalScore], map: "idx_investment_lead_priority_score")
  @@index([isDeleted, updateTime], map: "idx_investment_lead_deleted_update")
  @@index([ownerUserId], map: "idx_investment_lead_owner")
  @@map("investment_lead")
}

model InvestmentPublicOpportunity {
  opportunityId     BigInt    @id @default(autoincrement()) @map("opportunity_id")
  opportunityType   String    @map("opportunity_type") @db.VarChar(20)
  sourceSite        String?   @map("source_site") @db.VarChar(100)
  sourceUrl         String    @map("source_url") @db.VarChar(500)
  sourceKey         String?   @map("source_key") @db.VarChar(160)
  sourceTable       String?   @map("source_table") @db.VarChar(100)
  sourceId          String?   @map("source_id") @db.VarChar(100)
  title             String    @db.VarChar(255)
  city              String?   @db.VarChar(100)
  district          String?   @db.VarChar(100)
  areaText          String?   @map("area_text") @db.VarChar(100)
  areaSqm           Decimal?  @map("area_sqm") @db.Decimal(18, 2)
  priceText         String?   @map("price_text") @db.VarChar(100)
  industryText      String?   @map("industry_text") @db.VarChar(100)
  contactName       String?   @map("contact_name") @db.VarChar(100)
  phoneNumber       String?   @map("phone_number") @db.VarChar(50)
  description       String?   @db.Text
  publishedAt       DateTime? @map("published_at")
  publishedDateText String?   @map("published_date_text") @db.VarChar(100)
  effectiveUntil    DateTime? @map("effective_until")
  opportunityStatus String    @default("EFFECTIVE") @map("opportunity_status") @db.VarChar(30)
  sourceCode        String?   @map("source_code") @db.VarChar(80)
  isGuangdong       Int       @default(0) @map("is_guangdong") @db.TinyInt
  hasDetailEvidence Int       @default(0) @map("has_detail_evidence") @db.TinyInt
  qualityGrade      String?   @map("quality_grade") @db.VarChar(30)
  score             Int?
  tagsJson          String?   @map("tags_json") @db.Text
  detailJson        String?   @map("detail_json") @db.LongText
  lastSyncedAt      DateTime  @default(now()) @map("last_synced_at")
  createTime        DateTime  @default(now()) @map("create_time")
  updateTime        DateTime  @default(now()) @updatedAt @map("update_time")
  @@index([opportunityType], map: "investment_public_opportunity_type_idx")
  @@index([sourceSite], map: "investment_public_opportunity_source_site_idx")
  @@index([sourceUrl(length: 191)], map: "investment_public_opportunity_source_url_idx")
  @@index([lastSyncedAt], map: "investment_public_opportunity_last_synced_at_idx")
  @@index([opportunityType, opportunityStatus, publishedAt], map: "investment_public_opportunity_effective_idx")
  @@index([opportunityStatus, isGuangdong, hasDetailEvidence], map: "investment_public_opportunity_quality_idx")
  @@index([sourceCode, opportunityStatus], map: "investment_public_opportunity_source_code_idx")
  @@index([opportunityType, opportunityStatus, qualityGrade, isGuangdong, hasDetailEvidence, publishedAt, lastSyncedAt, opportunityId], map: "investment_public_opportunity_strict_list_idx")
  @@index([opportunityType, opportunityStatus, sourceSite, qualityGrade, isGuangdong, hasDetailEvidence, publishedAt, lastSyncedAt, opportunityId], map: "investment_public_opportunity_strict_source_list_idx")
  @@map("investment_public_opportunity")
}

