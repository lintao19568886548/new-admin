  enterpriseName           String    @map("enterprise_name") @db.VarChar(200)
  unifiedSocialCreditCode  String?   @map("unified_social_credit_code") @db.VarChar(100)
  phoneNumber              String?   @map("phone_number") @db.VarChar(30)
