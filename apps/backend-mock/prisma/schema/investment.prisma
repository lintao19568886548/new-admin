  @@map("lead_score_rule")
}

model LeadScoreBreakdown {
  breakdownId BigInt   @id @default(autoincrement()) @map("breakdown_id")
  leadId      BigInt   @map("lead_id")
  eventId     BigInt?  @map("event_id")
  ruleId      BigInt   @map("rule_id")
  ruleCode    String   @map("rule_code") @db.VarChar(100)
  ruleName    String   @map("rule_name") @db.VarChar(100)
  scoreDelta  Int      @default(0) @map("score_delta")
  reason      String   @db.VarChar(500)
  createTime  DateTime @default(now()) @map("create_time")

  @@index([leadId])
  @@index([eventId])
  @@map("lead_score_breakdown")
}

model InvestmentEnterprise {
