model InvestmentLead {
  leadId            BigInt    @id @default(autoincrement()) @map("lead_id")
  enterpriseId      BigInt    @map("enterprise_id")
  parkId            BigInt?   @map("park_id")
  leadSource        String    @default("MANUAL_IMPORT") @map("lead_source") @db.VarChar(100)
  intentArea        Decimal?  @map("intent_area") @db.Decimal(18, 2)
  intentScore       Int       @default(0) @map("intent_score")
  matchScore        Int       @default(0) @map("match_score")
  reachableScore    Int       @default(0) @map("reachable_score")
  totalScore        Int       @default(0) @map("total_score")
  priorityLevel     String    @default("C") @map("priority_level") @db.VarChar(10)
  stage             String    @default("NEW") @db.VarChar(30)
  ownerUserId       Int?      @map("owner_user_id")
  latestTaskId      String?   @map("latest_task_id") @db.VarChar(100)
