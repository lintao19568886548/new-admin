model Image {
  imgId              Int                  @id @default(autoincrement()) @map("img_id")
  imgUrl             String               @map("img_url") @db.LongText
  hash               String               @unique @map("hash") // 新增：存储文件哈希值，并确保唯一性
  createdTime        DateTime?            @default(now()) @map("created_time")
  updatedTime        DateTime?            @updatedAt @map("updated_time")
  investments        InvestmentImage[]    @relation("ImageToInvestmentImage")
  floorImages        FactoryFloorImage[]  @relation("ImageToFactoryFloorImage")
  dormitoryImages    DormitoryImage[]     @relation("ImageToDormitoryImage")
  parkImages         ParkImage[]          @relation("ImageToParkImage")
  Reimbursement      ReimbursementImage[] @relation("ImageToReimbursementImage")
  bindings           ImageBinding[]       @relation("ImageToImageBinding")
  firefightingImages FirefightingImage[]  @relation("ImageToFirefightingImage")
  transformerImages  TransformerImage[]   @relation("ImageToTransformerImage")
  salaryImages       SalaryImage[]        @relation("ImageToSalaryImage")
  tenantImages       TenantImage[]        @relation("ImageToTenantImage")

  @@map("image")
}

model InvestmentImage {
  id           Int        @id @default(autoincrement())
  investmentId Int        @map("investment_id")
  imgId        Int        @map("img_id")
  investment   Investment @relation("InvestmentToInvestmentImage", fields: [investmentId], references: [investmentId])
  image        Image      @relation("ImageToInvestmentImage", fields: [imgId], references: [imgId])
  createTime   DateTime   @default(now()) @map("create_time")
  updateTime   DateTime?  @updatedAt @map("update_time")

  @@index([investmentId])
  @@index([imgId])
  @@map("investment_image")
}

// 移除旧的 FactoryImage 模型
// model FactoryImage { ... }

// 添加新的 FactoryFloorImage 模型
model FactoryFloorImage {
  id         Int           @id @default(autoincrement())
  floorId    Int           @map("floor_id")
  imgId      Int           @map("img_id")
  floor      FactoryFloor? @relation("FactoryFloorToFactoryFloorImage", fields: [floorId], references: [floorId])
  image      Image?        @relation("ImageToFactoryFloorImage", fields: [imgId], references: [imgId]) // 需要在 Image 模型中添加反向关联
  createTime DateTime      @default(now()) @map("create_time")
  updateTime DateTime?     @updatedAt @map("update_time")

  @@index([floorId])
  @@index([imgId])
  @@map("factory_floor_image")
}

// 添加新的 DormitoryImage 模型
model DormitoryImage {
  id          Int        @id @default(autoincrement())
  dormitoryId Int        @map("dormitory_id")
  imgId       Int        @map("img_id")
  dormitory   Dormitory? @relation("DormitoryToDormitoryImage", fields: [dormitoryId], references: [dormitoryId]) // 需要在 Dormitory 模型中添加反向关联
  image       Image?     @relation("ImageToDormitoryImage", fields: [imgId], references: [imgId]) // 需要在 Image 模型中添加反向关联
  createTime  DateTime   @default(now()) @map("create_time")
  updateTime  DateTime?  @updatedAt @map("update_time")

  @@index([dormitoryId])
  @@index([imgId])
  @@map("dormitory_image")
}

// 添加新的 ParkImage 模型
model ParkImage {
  id         Int       @id @default(autoincrement())
  parkId     Int       @map("park_id")
  imgId      Int       @map("img_id")
  park       Park      @relation("ParkToParkImage", fields: [parkId], references: [parkId])
  image      Image     @relation("ImageToParkImage", fields: [imgId], references: [imgId])
  createTime DateTime  @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([parkId])
  @@index([imgId])
  @@map("park_image")
}

model ReimbursementImage {
  id              Int            @id @default(autoincrement())
  reimbursementId Int            @map("reimbursement_id")
  imgId           Int            @map("img_id")
  reimbursement   Reimbursement? @relation("ReimbursementToReimbursementImage", fields: [reimbursementId], references: [id])
  image           Image?         @relation("ImageToReimbursementImage", fields: [imgId], references: [imgId])
  createTime      DateTime       @default(now()) @map("create_time")
  updateTime      DateTime?      @updatedAt @map("update_time")

  @@index([reimbursementId])
  @@index([imgId])
  @@map("reimbursement_image")
}

model ImageBinding {
  id         Int       @id @default(autoincrement())
  bizType    String    @map("biz_type") @db.VarChar(50)
  bizId      Int       @map("biz_id")
  imgId      Int       @map("img_id")
  field      String?   @db.VarChar(30)
  sort       Int       @default(0)
  image      Image?    @relation("ImageToImageBinding", fields: [imgId], references: [imgId])
  createTime DateTime? @default(now()) @map("create_time")
  updateTime DateTime? @updatedAt @map("update_time")

  @@index([bizType, bizId])
  @@index([bizType, bizId, field])
  @@index([imgId])
  @@unique([bizType, bizId, imgId])
  @@map("image_binding")
}

model FirefightingImage {
  id             Int           @id @default(autoincrement())
  firefightingId Int           @map("firefighting_id")
  imgId          Int           @map("img_id")
  firefighting   Firefighting? @relation("FirefightingToFirefightingImage", fields: [firefightingId], references: [firefightingId])
  image          Image?        @relation("ImageToFirefightingImage", fields: [imgId], references: [imgId])
  createTime     DateTime      @default(now()) @map("create_time")
  updateTime     DateTime?     @updatedAt @map("update_time")

  @@index([firefightingId])
  @@index([imgId])
  @@map("firefighting_image")
}

model TransformerImage {
  id            Int          @id @default(autoincrement())
  transformerId Int          @map("transformer_id")
  imgId         Int          @map("img_id")
  transformer   Transformer? @relation("TransformerToTransformerImage", fields: [transformerId], references: [transformerId])
  image         Image?       @relation("ImageToTransformerImage", fields: [imgId], references: [imgId])
  createTime    DateTime     @default(now()) @map("create_time")
  updateTime    DateTime?    @updatedAt @map("update_time")

  @@index([transformerId])
  @@index([imgId])
  @@map("transformer_image")
}

model SalaryImage {
  id            Int          @id @default(autoincrement())
  salaryId      Int          @map("salary_id")
  imgId         Int          @map("img_id")
  salary        Salary?      @relation("SalaryToSalaryImage", fields: [salaryId], references: [salaryId])
  image         Image?       @relation("ImageToSalaryImage", fields: [imgId], references: [imgId])
  createTime    DateTime     @default(now()) @map("create_time")
  updateTime    DateTime?    @updatedAt @map("update_time")

  @@index([salaryId])
  @@index([imgId])
  @@map("salary_image")
}

model TenantImage {
  id             Int           @id @default(autoincrement())
  rentalTenantId Int           @map("rental_tenant_id")
  imgId          Int           @map("img_id")
  tenant         RentalTenant? @relation("RentalTenantToTenantImage", fields: [rentalTenantId], references: [rentalTenantId])
  image          Image?        @relation("ImageToTenantImage", fields: [imgId], references: [imgId])
  createTime     DateTime      @default(now()) @map("create_time")
  updateTime     DateTime?     @updatedAt @map("update_time")

  @@index([rentalTenantId])
  @@index([imgId])
  @@map("tenant_image")
}
