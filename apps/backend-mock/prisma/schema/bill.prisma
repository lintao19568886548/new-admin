model AmountBill {
  billId               Int           @id @default(autoincrement()) @map("bill_id")
  projectName          String        @map("project_name")
  tenantName           String?       @map("tenant_name")
  eleFee               Decimal?      @default(0.00) @map("ele_fee") @db.Decimal(10, 2)
  waterFee             Decimal?      @default(0.00) @map("water_fee") @db.Decimal(10, 2)
  receiveFee           Decimal?      @default(0.00) @map("receive_fee") @db.Decimal(10, 2)
  factoryRent          Decimal?      @default(0.00) @map("factory_rent") @db.Decimal(10, 2)
  managementFee        Decimal?      @default(0.00) @map("management_fee") @db.Decimal(10, 2)
  invoiceTax           Decimal?      @default(0.00) @map("invoice_tax") @db.Decimal(10, 2)
  totalFee             Decimal?      @default(0.00) @map("total_fee") @db.Decimal(10, 2)
  serviceFee           Decimal?      @default(0.00) @map("service_fee") @db.Decimal(10, 2)
  garbageFee           Decimal?      @default(0.00) @map("garbage_fee") @db.Decimal(10, 2)
  penaltyFee           Decimal?      @default(0.00) @map("penalty_fee") @db.Decimal(10, 2)
  serviceRate          Decimal?      @map("service_rate") @db.Decimal(5, 2)
  garbageRate          Decimal?      @map("garbage_rate") @db.Decimal(5, 2)
  penaltyRate          Decimal?      @map("penalty_rate") @db.Decimal(5, 2)
  penaltyItem          String?       @map("penalty_item") @db.VarChar(200)
  peakAndValleyEleRate Decimal?      @map("peak_and_valley_ele_rate") @db.Decimal(5, 2)
  peakAndValleyEleItem String?       @map("peak_and_valley_ele_item") @db.VarChar(200)
  taxRate              String?       @map("tax_rate") @db.LongText /// 开票税金, 以json格式存储
  tenantId             Int?          @map("tenant_id")
  remark               String?       @db.VarChar(100)
  receiptTime          DateTime?     @map("receipt_time")
  createTime           DateTime?     @default(now()) @map("create_time")
  updateTime           DateTime?     @updatedAt @map("update_time")
  tenant               RentalTenant? @relation("AmountBillToTenant", map: "tenant_no_fk", fields: [tenantId], references: [rentalTenantId])
  eleBills             EleBill[]     @relation("EleBillToAmountBill")
  waterBills           WaterBill[]   @relation("WaterBillToAmountBill")
  parkId               Int?          @map("park_id")
  park                 Park?         @relation("ParkToAmountBill", fields: [parkId], references: [parkId])

  @@index([tenantId])
  @@index([parkId])
  @@map("amount_bill")
}

model EleBill {
  eleId           Int        @id @default(autoincrement()) @map("ele_id") @db.Int
  billId          Int        @map("bill_id")
  meterName       String     @map("meter_name")
  previousReading Decimal?   @default(0.00) @map("previous_reading") @db.Decimal(10, 2)
  currentReading  Decimal?   @default(0.00) @map("current_reading") @db.Decimal(10, 2)
  monthlyUsage    Decimal?   @default(0.00) @map("monthly_usage") @db.Decimal(10, 2)
  multiplier      Decimal?   @default(0.00) @db.Decimal(10, 2)
  totalUsage      Decimal?   @default(0.00) @map("total_usage") @db.Decimal(10, 2)
  unitPrice       Decimal?   @default(0.00) @map("unit_price") @db.Decimal(10, 8)
  amount          Decimal?   @default(0.00) @db.Decimal(10, 2)
  remark          String?    @db.VarChar(100)
  receiptTime     DateTime?  @map("receipt_time")
  createTime      DateTime?  @default(now()) @map("create_time")
  updateTime      DateTime?  @updatedAt @map("update_time")
  amountBill      AmountBill @relation("EleBillToAmountBill", map: "ele_bill_no_fk", fields: [billId], references: [billId])

  @@index([billId])
  @@map("ele_bill")
}

model WaterBill {
  waterId         Int         @id @default(autoincrement()) @map("water_id")
  billId          Int         @map("bill_id")
  meterName       String      @map("meter_name")
  previousReading Decimal?    @default(0.00) @map("previous_reading") @db.Decimal(10, 2)
  currentReading  Decimal?    @default(0.00) @map("current_reading") @db.Decimal(10, 2)
  monthlyUsage    Decimal?    @default(0.00) @map("monthly_usage") @db.Decimal(10, 2)
  multiplier      Decimal?    @default(0.00) @db.Decimal(10, 2)
  totalUsage      Decimal?    @default(0.00) @map("total_usage") @db.Decimal(10, 2)
  unitPrice       Decimal?    @default(0.00) @map("unit_price") @db.Decimal(10, 8)
  amount          Decimal?    @default(0.00) @db.Decimal(10, 2)
  remark          String?     @db.VarChar(100)
  receiptTime     DateTime?   @map("receipt_time")
  createTime      DateTime?   @default(now()) @map("create_time")
  updateTime      DateTime?   @updatedAt @map("update_time")
  amountBill      AmountBill? @relation("WaterBillToAmountBill", map: "water_bill_no_fk", fields: [billId], references: [billId])

  @@index([billId])
  @@map("water_bill")
}
