model Finance {
  financeId       Int            @id @default(autoincrement()) @map("finance_id")
  billName        String         @map("bill_name") @db.VarChar(100)
  billCategory    String         @map("bill_category") @db.VarChar(50)
  amount          Decimal        @db.Decimal(15, 2)
  transactionType String         @map("transaction_type") @db.VarChar(20)
  transactionTime DateTime       @map("transaction_time")
  remark          String?        @db.VarChar(200)
  createTime      DateTime?      @default(now()) @map("create_time")
  updateTime      DateTime?      @updatedAt @map("update_time")
  parkId          Int?           @map("park_id")
  park            Park?          @relation("ParkToFinance", fields: [parkId], references: [parkId])
  amountBill      AmountBill?    @relation("AmountBillToFinance")
  status          Int            @default(0)
  isDeleted       Boolean        @default(false) @map("is_deleted")
  images          FinanceImage[] @relation("FinanceToFinanceImage")

  @@index([parkId])
  @@index([billName, transactionType, isDeleted], map: "finance_bill_name_transaction_type_is_deleted_idx")
  @@index([remark, transactionType, isDeleted], map: "finance_remark_transaction_type_is_deleted_idx")
  @@index([transactionTime, isDeleted], map: "finance_transaction_time_is_deleted_idx")
  @@map("finance")
}

model FinanceImage {
  id        Int     @id @default(autoincrement())
  url       String  @db.VarChar(255)
  financeId Int     @map("finance_id")
  finance   Finance @relation("FinanceToFinanceImage", fields: [financeId], references: [financeId])

  @@index([financeId])
  @@map("finance_image")
}
