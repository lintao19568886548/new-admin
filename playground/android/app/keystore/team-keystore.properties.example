# 团队共用签名配置文件示例
# 复制此文件为 team-keystore.properties 并填入实际密码
# 注意：team-keystore.properties 文件已被添加到 .gitignore，不会被提交到版本控制

# Keystore 文件路径（相对于 app 目录）
storeFile=keystore/team-release-key.jks

# Keystore 密码（请替换为实际密码）
storePassword=请填入实际的keystore密码

# Key 别名
keyAlias=team-release-key

# Key 密码（请替换为实际密码，通常与keystore密码相同）
keyPassword=请填入实际的key密码

# 使用说明：
# 1. 将此文件复制为 team-keystore.properties
# 2. 将上述密码占位符替换为实际密码
# 3. 确保 team-release-key.jks 文件存在于 keystore 目录中
# 4. 不要将包含真实密码的文件提交到版本控制系统

# 环境变量方式（可选，更安全）：
# 您也可以设置以下环境变量来代替配置文件：
# STORE_FILE=app/keystore/team-release-key.jks
# STORE_PASSWORD=你的keystore密码
# KEY_ALIAS=team-release-key
# KEY_PASSWORD=你的key密码