.invite-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx 56rpx;
  color: #14243f;
  background:
    linear-gradient(180deg, rgba(224, 244, 255, 0.9) 0%, rgba(255, 255, 255, 0.96) 58%),
    #f3f9ff;
}

.poster {
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 34rpx 34rpx;
  background: #ffffff;
  border: 1rpx solid #d7e8f8;
  border-radius: 16rpx;
  box-shadow: 0 24rpx 70rpx rgba(23, 57, 104, 0.12);
}

.poster::after {
  position: absolute;
  top: -110rpx;
  right: -140rpx;
  width: 330rpx;
  height: 330rpx;
  pointer-events: none;
  content: '';
  background: rgba(40, 151, 255, 0.12);
  border-radius: 999rpx;
}

.brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.brand-mark {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  background: #1677ff;
  border-radius: 12rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.brand-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.poster-title {
  position: relative;
  z-index: 1;
  margin-top: 42rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
}

.poster-desc {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: #4a5f7b;
}

.value-list {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 16rpx;
  margin-top: 34rpx;
}

.value-item {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  background: #f6fbff;
  border: 1rpx solid #dcecfb;
  border-radius: 12rpx;
}

.value-item text {
  font-size: 24rpx;
  color: #53657d;
}

.value-item strong {
  max-width: 310rpx;
  overflow-wrap: anywhere;
  font-size: 27rpx;
  font-weight: 700;
  color: #0f6fbd;
  text-align: right;
}

.price-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.price-row view {
  min-width: 0;
  padding: 18rpx 10rpx;
  text-align: center;
  background: #eef7ff;
  border: 1rpx solid #d2e7fb;
  border-radius: 12rpx;
}

.price-row text {
  display: block;
  font-size: 21rpx;
  color: #5e718b;
}

.price-row strong {
  display: block;
  margin-top: 6rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: #0f5fa8;
}

.action-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 28rpx;
  margin-top: 24rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #dce7f5;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 54rpx rgba(15, 35, 70, 0.1);
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
}

.desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #526277;
}

.error {
  color: #c2410c;
}

.primary {
  height: 88rpx;
  margin-top: 30rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  color: #ffffff;
  background: #1677ff;
  border-radius: 12rpx;
}

.bound-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  color: #0f766e;
  background: #dff7f2;
  border-radius: 999rpx;
}

.channel-tag {
  margin: 14rpx 0 0;
  font-size: 22rpx;
  color: #6b7788;
}
